        <item name="android:fontFamily">@font/app_fonts</item>

        <item name="shapeAppearanceCornerExtraSmall">@style/ShapeAppearance.BYS.Corner.ExtraSmall</item>
        <item name="shapeAppearanceCornerSmall">@style/ShapeAppearance.BYS.Corner.Small</item>
        <item name="shapeAppearanceCornerMedium">@style/ShapeAppearance.BYS.Corner.Medium</item>
        <item name="shapeAppearanceCornerLarge">@style/ShapeAppearance.BYS.Corner.Large</item>
        <item name="shapeAppearanceCornerExtraLarge">@style/ShapeAppearance.BYS.Corner.ExtraLarge</item>
        <item name="shapeAppearanceSmallComponent">@style/ShapeAppearance.BYS.Corner.Small</item>
        <item name="shapeAppearanceMediumComponent">@style/ShapeAppearance.BYS.Corner.Medium</item>
        <item name="shapeAppearanceLargeComponent">@style/ShapeAppearance.BYS.Corner.Large</item>

        <item name="textAppearanceDisplayLarge">@style/TextAppearance.BYS.DisplayLarge</item>
        <item name="textAppearanceDisplayMedium">@style/TextAppearance.BYS.DisplayMedium</item>
        <item name="textAppearanceDisplaySmall">@style/TextAppearance.BYS.DisplaySmall</item>
        <item name="textAppearanceHeadlineLarge">@style/TextAppearance.BYS.HeadlineLarge</item>
        <item name="textAppearanceHeadlineMedium">@style/TextAppearance.BYS.HeadlineMedium</item>
        <item name="textAppearanceHeadlineSmall">@style/TextAppearance.BYS.HeadlineSmall</item>
        <item name="textAppearanceTitleLarge">@style/TextAppearance.BYS.TitleLarge</item>
