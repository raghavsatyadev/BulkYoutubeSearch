        <item name="materialButtonStyle">@style/ButtonStyleMerged</item>
        <item name="materialButtonTonalStyle">@style/ButtonStyleTonal</item>
        <item name="borderlessButtonStyle">@style/ButtonStyleText</item>
        <item name="textInputStyle">@style/TextInputLayoutStyle</item>

        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">?attr/isLightTheme</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="o_mr1">?attr/isLightTheme</item>

        <item name="android:windowActivityTransitions">true</item>
        <item name="android:windowAllowEnterTransitionOverlap">true</item>
        <item name="android:windowAllowReturnTransitionOverlap">true</item>
