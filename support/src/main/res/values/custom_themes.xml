    <style name="AppTheme.Merged.ButtonRounded" />

    <style name="AppThemeDay" parent="AppTheme.Merged.ButtonRounded" />

    <style name="AppThemeDay.Entry">
        <item name="android:windowBackground">@drawable/img_splash</item>
        <item name="materialButtonStyle">@style/ButtonStyleEntry</item>
    </style>

</resources>
