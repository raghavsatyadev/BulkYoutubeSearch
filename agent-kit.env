# Single config file for the Android Agent Kit scripts. Fill the blanks.
APP_MODULE=:app
# Build variant for compile/assemble/test tasks, e.g. DevDebug when the app has flavors.
APP_VARIANT=DevDebug
APPLICATION_ID=io.github.raghavsatyadev.bys
BASE_BRANCH=master
# Pin a ktfmt version (blank = latest release from Maven Central).
KTFMT_VERSION=
# Android NDK version that setup-env checks (blank = skip the check).
NDK_VERSION=
